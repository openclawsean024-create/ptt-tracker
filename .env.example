# PTT Tracker — environment variable template
#
# Copy this file to `.env` and fill in real values:
#
#     cp .env.example .env
#
# `.env` is git-ignored; never commit it.
#
# Both `tracker.js` (CLI) and `api/tracker.js` (Vercel serverless) read these
# variables from `process.env`. The Python entrypoint `ptt_tracker.py` reads
# them via `os.environ`. Do NOT put these values in `config.json`.

# ---------------------------------------------------------------------------
# Telegram notifications (CLI + Telegram bot mode)
# ---------------------------------------------------------------------------

# Required only if you want Telegram notifications.
# Bot token obtained from @BotFather on Telegram.
PTT_TELEGRAM_TOKEN=

# Numeric chat id of the target conversation (user / group / channel).
PTT_TELEGRAM_CHAT_ID=

# ---------------------------------------------------------------------------
# Vercel serverless function (`api/tracker.js`) hardening
# ---------------------------------------------------------------------------

# Exact origin permitted to call `/api/tracker`. Defaults to the production
# frontend URL when unset. NEVER set this to "*" — `api/tracker.js` triggers
# PTT scraping and (when configured) Telegram side effects, so it must not
# be reachable from arbitrary origins.
ALLOWED_ORIGIN=https://ptt-alertor-olive.vercel.app

# Shared secret required on the `X-PTT-API-Key` header for requests to
# `/api/tracker`. When unset, the API is reachable from `ALLOWED_ORIGIN`
# without a key — acceptable for a demo deploy, but production operators
# should generate a strong random value (e.g. `openssl rand -hex 32`) and
# set BOTH `ALLOWED_ORIGIN` and `PTT_API_KEY` together.
PTT_API_KEY=

# ---------------------------------------------------------------------------
# Diagnostic logging
# ---------------------------------------------------------------------------

# Set to any non-empty value to enable verbose diagnostic console output
# (per-board intermediate progress, unhandled error traces). Off by default
# to keep CLI stdout / serverless logs uncluttered.
DEBUG_PTT=

# ---------------------------------------------------------------------------
# Dcard source connector (round-2 M2)
# ---------------------------------------------------------------------------

# Set to `1` to actually issue HTTPS requests to `www.dcard.tw`. Default
# is OFF so development sandboxes, CI, and test runs do not depend on
# outbound network access. The connector still parses any fixture data
# passed in via `node --eval` / tests, and `normalize()` is unconditional.
# When OFF, `fetch()` returns `[]` and the rest of the pipeline skips the
# Dcard source gracefully. Recommended values:
#   * local dev with TW IP / VPN  → DCARD_FETCH_ENABLED=1
#   * CI / sandbox / non-TW IP     → leave blank (default)
DCARD_FETCH_ENABLED=

# Optional User-Agent override. Dcard sometimes serves different content
# (or 403s) based on UA; default is a descriptive UA identifying the
# tracker. Set this if you want to mimic a specific browser.
DCARD_USER_AGENT=
