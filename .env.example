# === Optional: AI sentiment analysis ===
# Leave empty to use heuristic mode (keyword-based scoring)
OPENAI_API_KEY=

# === Optional: LINE Notify token for alerts ===
# Leave empty for mock mode
LINE_NOTIFY_TOKEN=

# === Optional: Slack webhook for alert fallback ===
SLACK_WEBHOOK_URL=

# === Optional: Resend API key for email fallback ===
RESEND_API_KEY=

# === Optional: Stripe ===
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# === Optional: PTT 18+ cookie for real PTT scraping ===
# PTT_COOKIE=over18=1

# === Optional: Threads/Meta Business token (post MVP) ===
# META_ACCESS_TOKEN=